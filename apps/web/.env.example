# Brighten web — Supabase connection (anon read-only key)
# Set these in Vercel Environment Variables. DO NOT commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER put SUPABASE_SERVICE_ROLE_KEY here.
# Service role is for engine (cron/feedback) only — never on Vercel.
